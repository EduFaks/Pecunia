# Pecunia — copy to .env and start: docker compose up -d
# Every value below is optional; the defaults just work.

# Port the pecunia-web UI (nginx) is served on. This is the only port the
# stack publishes to the host — pecunia-api no longer binds a host port; the
# browser talks to it exclusively through pecunia-web's /api/ proxy.
PECUNIA_PORT=8480

# Leave empty: Pecunia generates a strong key on first boot and persists it.
# If you set one, use 32+ random characters — weak values refuse to start.
PECUNIA_SECRET_KEY=

# Optional first-run guard. If set, POST /api/v1/setup/initialize additionally
# requires an "X-Setup-Token: <this value>" header — close the first-visit-wins
# window when exposing an UNINITIALIZED instance to the internet. The browser
# wizard does NOT send this header, so with a token set you initialize via the
# API (curl with X-Setup-Token) — or clear it once you're ready to use the
# wizard. Leave empty for localhost/LAN.
PECUNIA_SETUP_TOKEN=

# Internal database credentials (not exposed outside the compose network)
PECUNIA_DB_USER=pecunia
PECUNIA_DB_PASSWORD=pecunia
PECUNIA_DB_NAME=pecunia

# Static IP of the pecunia-web container on the internal "pecunia" network,
# and the subnet it's carved from. The API trusts X-Forwarded-For only from
# this address (PECUNIA_TRUSTED_PROXIES_RAW is wired to it automatically in
# docker-compose.yml). .10 is deliberately outside the low range Docker hands
# out to pecunia-db/pecunia-api's unstated (dynamic) addresses, so it never
# collides with them. The default subnet avoids 172.31.0.0/16 (the AWS
# default-VPC range — using it on a default-VPC EC2 host can shadow VPC DNS and
# break connectivity). Change it if 10.89.0.0/24 clashes with an existing network.
PECUNIA_WEB_IP=10.89.0.10
PECUNIA_SUBNET=10.89.0.0/24

# Comma-separated Host allowlist (e.g. pecunia.example.com). Empty = allow any
# Host (fine for localhost/LAN). Set in production to block DNS-rebinding.
PECUNIA_SERVER_NAMES_RAW=
